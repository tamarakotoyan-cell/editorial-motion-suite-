.DS_Store
__pycache__/
*.pyc
# dist is generated by build-skills.py and must never live inside this tree —
# a second SKILL.md with the same name: silently breaks plugin loading
dist/
editorial-motion-dist/
# eval run output — artifacts, transcripts and lint logs, regenerated per run
evals/runs/

# webfont cache for examples/ — fetched on demand by build.py
.fontcache/
